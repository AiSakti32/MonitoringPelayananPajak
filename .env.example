APP_NAME="Kajang Lako"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

DB_HOST=localhost
DB_PORT=3306
DB_NAME=kajang_lako
DB_USER=root
DB_PASS=

SESSION_NAME=kajanglako_session
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# Login rate limit (per IP + username window)
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=300
